# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=collectify

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── WhatsApp — Meta Cloud API ───────────────────────────
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── WhatsApp — inbound webhook (Phase 22) ───────────────
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-string
META_WHATSAPP_APP_SECRET=

# ── WhatsApp — global kill switch (2026-09-06 incident response) ──
# Set to "true" to stop every outbound WhatsApp send, of every type,
# without a code change or redeploy of code (just a var change).
WHATSAPP_SENDING_PAUSED=false

# ── WhatsApp — test allowlist (2026-09-08) ──────────────
# Comma-separated E.164 phone numbers that bypass WHATSAPP_SENDING_PAUSED
# above — everyone else stays blocked. Leave empty here and in every
# committed file; set real numbers only in Railway's Variables tab or a
# local, gitignored .env. Never commit real phone numbers.
WHATSAPP_TEST_RECIPIENTS=

# ── Loan import — temporary operational toggle (2026-09-08) ──
# Set to "true" while the historical pagarés backfill is in progress, to
# skip the mora-block/cupo guard for loans created via the Excel import
# only (the interactive "Crear préstamo" form is unaffected). Set back to
# "false" (or remove it) once the backfill is done — no code change
# needed either way.
LOAN_IMPORT_SKIP_CREDIT_CHECK=false

# ── Scheduled jobs ──────────────────────────────────────
OVERDUE_REMINDER_CRON=0 9 * * 1,3,5
UPCOMING_DUE_REMINDER_CRON=0 8 * * *
UPCOMING_DUE_REMINDER_DAYS=5
ACCOUNT_SUMMARY_REMINDER_CRON=0 8 1 * *

# ── CORS ────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
