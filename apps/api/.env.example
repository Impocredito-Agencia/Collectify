# ── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=collectify

# ── Auth ────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── WhatsApp — Meta Cloud API ───────────────────────────
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=

# ── WhatsApp — inbound webhook (Phase 22) ───────────────
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-a-random-string
META_WHATSAPP_APP_SECRET=

# ── WhatsApp — global kill switch (2026-09-06 incident response) ──
# Set to "true" to stop every outbound WhatsApp send, of every type,
# without a code change or redeploy of code (just a var change).
WHATSAPP_SENDING_PAUSED=false

# ── WhatsApp — test allowlist (2026-09-08) ──────────────
# Comma-separated E.164 phone numbers that bypass WHATSAPP_SENDING_PAUSED
# above — everyone else stays blocked. Leave empty here and in every
# committed file; set real numbers only in Railway's Variables tab or a
# local, gitignored .env. Never commit real phone numbers.
WHATSAPP_TEST_RECIPIENTS=

# ── WhatsApp — payment confirmation kill switch (2026-09-11) ──
# Set to "true" to stop PaymentConfirmation/PaidInFull messages
# specifically, while historical payments are being backfilled — see
# Loan.isNewLoan for the equivalent switch on new-loan messages.
# Independent of WHATSAPP_SENDING_PAUSED above; both compose (either one
# blocks). Turn back off once real payments start flowing normally.
PAYMENT_CONFIRMATION_MESSAGES_PAUSED=false

# ── Loans — silent pending-cuota correction (2026-09-25) ─
# Both must allow it: the flag on AND the pagaré listed (comma-separated,
# "#0965", "0965" and "965" all match the same loan).
LOAN_INSTALLMENT_ADJUSTMENT_ENABLED=false
LOAN_INSTALLMENT_ADJUSTMENT_PROMISSORY_NOTES=

# ── File uploads — Cloudinary signed uploads (Phase 12) ─
# Pending — no Cloudinary account has been created for this project yet.
# Once one exists, these three come from the Cloudinary dashboard
# (Settings → Account → API Keys). UploadsService fails clearly instead
# of silently if a signature is requested while any of these are blank.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Scheduled jobs ──────────────────────────────────────
OVERDUE_REMINDER_CRON=0 9 * * 1,3,5
UPCOMING_DUE_REMINDER_CRON=0 8 * * *
UPCOMING_DUE_REMINDER_DAYS=5
ACCOUNT_SUMMARY_REMINDER_CRON=0 8 1 * *
NEW_LOAN_REMINDER_CRON=0 10 * * 1

# ── CORS ────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
